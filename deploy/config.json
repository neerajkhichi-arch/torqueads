{
  "version": 3,
  "routes": [
    {
      "src": "/(.*)",
      "headers": {
        "X-Robots-Tag": "noindex, nofollow",
        "X-Content-Type-Options": "nosniff",
        "Referrer-Policy": "strict-origin-when-cross-origin"
      },
      "continue": true
    },
    { "handle": "filesystem" }
  ]
}
